# SEC requires a descriptive User-Agent that includes your name and email.
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Your Name your-email@example.com"

# Read-write connection used by ingest (matches docker-compose.yml).
DATABASE_URL="postgresql://intel:intel@localhost:5432/intel"

# Local disk cache for SEC responses.
SEC_CACHE_DIR="data/sec_cache"

# Requests per second to SEC (kept under their 10 req/s limit).
SEC_RATE_LIMIT=8

# Embeddings (Decision D3: local bge-small-en-v1.5, 384-dim, swappable).
EMBEDDING_PROVIDER="local_bge"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIM=384
EMBED_BATCH_SIZE=32

# Chunking (word-based sliding window).
CHUNK_TARGET_WORDS=400
CHUNK_OVERLAP_WORDS=60

# Reranking (local cross-encoder).
RERANK_ENABLED=true
RERANK_MODEL="BAAI/bge-reranker-base"
